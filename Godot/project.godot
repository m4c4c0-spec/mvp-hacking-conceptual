; Proyecto independiente. Abrir esta carpeta con Godot 4.6.3 Standard.
config_version=5

[application]
config/name="Protocolo Salida"
run/main_scene="res://Game/Levels/main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/description="Escape room educativo en primera persona · PC y base OpenXR"
config/version="0.2.0-godot"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/default_filters/anisotropic_filtering_level=2
textures/vram_compression/import_etc2_astc=true
textures/vram_compression/import_s3tc_bptc=true
anti_aliasing/quality/msaa_3d=1
anti_aliasing/quality/msaa_3d.mobile=0
anti_aliasing/quality/screen_space_aa=0
anti_aliasing/quality/use_debanding=false
anti_aliasing/quality/use_taa=false
lights_and_shadows/directional_shadow/size=1024
lights_and_shadows/directional_shadow/size.mobile=1024
lights_and_shadows/directional_shadow/16_bits=true
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=0
lights_and_shadows/directional_shadow/soft_shadow_filter_quality.mobile=0
lights_and_shadows/positional_shadow/atlas_size=1024
lights_and_shadows/positional_shadow/atlas_size.mobile=1024
lights_and_shadows/positional_shadow/atlas_16_bits=true
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=0
lights_and_shadows/positional_shadow/soft_shadow_filter_quality.mobile=0
lights_and_shadows/tighter_shadow_caster_culling=true
scaling_3d/mode=0
scaling_3d/scale=1.0
scaling_3d/scale.mobile=0.8
occlusion_culling/use_occlusion_culling=true
shading/overrides/force_lambert_over_burley=true
shading/overrides/force_lambert_over_burley.mobile=true
limits/opengl/max_lights_per_object=4
limits/opengl/max_renderable_lights=8
viewport/hdr_2d=false

[importer_defaults]

texture={
"compress/mode": 2,
"compress/normal_map": 0,
"mipmaps/generate": true,
"process/size_limit": 1024,
"roughness/mode": 0,
"roughness/src_normal": ""
}
scene={
"meshes/create_shadow_meshes": false,
"meshes/ensure_tangents": false,
"meshes/generate_lods": false,
"meshes/light_baking": 0
}

[physics]
common/physics_ticks_per_second=72

[xr]
openxr/enabled=false
openxr/enabled.quest=true
openxr/startup_alert=false
openxr/foveation_level=2
openxr/foveation_dynamic=false
shaders/enabled=true
